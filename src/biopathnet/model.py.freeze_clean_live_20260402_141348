        self._srp_last_stats = None
        nn.init.normal_(self.soft_path_prior, mean=0.0, std=1e-3)

        self.srp_query_gate = nn.Sequential(
            nn.Linear(input_dim, input_dim),
            nn.ReLU(),
            nn.Linear(input_dim, _srp_num_layer),
