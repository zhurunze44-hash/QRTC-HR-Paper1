        self.raa_cache_pt = os.getenv("RAA_CACHE_PT", "")
        self._raa_pack = None
        self._raa_last_stats = None
        self._raa_entity_weight = None
        self.mlp = layers.MLP(feature_dim, [feature_dim] * (num_mlp_layer - 1) + [1])
        if self.local_context_enable:
